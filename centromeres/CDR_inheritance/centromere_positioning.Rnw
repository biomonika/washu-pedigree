<<subCDR sum stats>>=
library(dplyr)
#take filtered subCDRs, and sum up their lengths
base_dir <- "/Users/mcechova/Desktop/CDR/CDR_positioning"

samples <- c("PAN010", "PAN011", "PAN027", "PAN028")

process_sample <- function(sample) {
  file <- file.path(
    base_dir,
    paste0("centrodip.MDR.", sample, ".filtered.minL3k.bed")
  )
  
  df <- read.table(file, sep = "\t", header = FALSE, stringsAsFactors = FALSE)
  
  df %>%
    mutate(length = V3 - V2) %>%
    group_by(V1) %>%
    summarise(total_length = sum(length), .groups = "drop") %>%
    rename(chromosome = V1) %>%
    mutate(sample = sample)
}

#This is the total sum of subCDRs across the four pedigree individuals
allsubCDRs <- bind_rows(lapply(samples, process_sample))
print(quantile(allsubCDRs$total_length, c(0.25, 0.75)))

@


<<>>=
# LOAD THE EXPORTED TABLE
# THIS SCRIPT RUNS THE SAME ANALYSIS FOR PAN010, PAN011, PAN028
library(dplyr)
library(ggplot2)
library(stringr)

# Define chromosome order: chr1 → chr22 → chrX
chr_levels <- paste0("chr", c(1:22, "X"))

# Samples to process
samples <- c("PAN010", "PAN011", "PAN028")

for (sid in samples) {

  # ------------------ LOAD & PREP DATA ------------------

  df <- as.data.frame(
    read.table(paste0("CDR.positioningTable.", sid, ".txt"), header = FALSE)
  )

  colnames(df) <- c(
    "haplotype1","start1","end1","midPoint1","CDRlength1","dist_frac1","location1","chr1","matching1",
    "haplotype2","start2","end2","midPoint2","CDRlength2","dist_frac2","location2","chr2","matching2"
  )

  stopifnot(
  all(
    df$chr1 == df$chr2 |
    (df$chr1 == "chrX" & df$chr2 == "chrY") |
    (df$chr1 == "chrY" & df$chr2 == "chrX")
  )
)


  ## assign haplotype1 and haplotype2 (instead of maternal/paternal)
  df <- df %>%
    mutate(
      lineage1 = str_extract(haplotype1, "(haplotype1|haplotype2)"),
      lineage2 = str_extract(haplotype2, "(haplotype1|haplotype2)")
    )

  # Filter cases where one haplotype is 'p' and the other is 'q'
  p_q <- df %>%
    filter(
      (location1 == "p" & location2 == "q") |
      (location1 == "q" & location2 == "p")
    )

  # ------------------ PLOT ------------------

  df <- df %>%
    mutate(
      chr1 = factor(chr1, levels = chr_levels)
    )
  
  minCDRsize<-min(sort(c(df$CDRlength1,df$CDRlength2)))
  maxCDRsize<-max(sort(c(df$CDRlength1,df$CDRlength2)))

  p <- ggplot(df) +
    # Background thirds (color-blind friendly grays)
    annotate("rect", xmin = 0,     xmax = 1/3, ymin = -Inf, ymax = Inf,
             fill = "#e8e8e8", alpha = 1) +
    annotate("rect", xmin = 1/3,   xmax = 2/3, ymin = -Inf, ymax = Inf,
             fill = "#cccccc", alpha = 1) +
    annotate("rect", xmin = 2/3,   xmax = 1,   ymin = -Inf, ymax = Inf,
             fill = "#e8e8e8", alpha = 1) +

    # Thin white vertical dividers
    geom_vline(xintercept = c(1/3, 2/3),
               colour = "white",
               linewidth = 0.4) +

    # Labels ABOVE the plot
    annotate("text", x = 1/6, y = Inf, vjust = -0.5,
             label = "p-arm proximal", size = 6) +
    annotate("text", x = 0.5, y = Inf, vjust = -0.5,
             label = "center", size = 6) +
    annotate("text", x = 5/6, y = Inf, vjust = -0.5,
             label = "q-arm proximal", size = 6) +

    # Segments connecting dist_frac1 to dist_frac2
    geom_segment(
      aes(x = dist_frac1, xend = dist_frac2,
          y = chr1, yend = chr1, colour = "black"),
      size = 0.7, lineend = "round"
    ) +

    # Points at both ends
    geom_point(
      aes(x = dist_frac1, y = chr1, size = CDRlength1, colour = lineage1),
      alpha = 0.95
    ) +
    geom_point(
      aes(x = dist_frac2, y = chr1, size = CDRlength2, colour = lineage2),
      alpha = 0.95
    ) +

    # Scales
    scale_x_continuous(limits = c(0, 1), expand = expansion(mult = 0.01)) +
    scale_color_manual(
      values = c(
        haplotype1 = "#663366",  # purple
        haplotype2 = "#DDC077"   # gold
      ),
      name = "Lineage"
    ) +
    scale_size_area(
      name = "CDR size (bp)",
      max_size = 7,
      limits = c(minCDRsize, maxCDRsize)
    ) +

    # Reverse y-axis so chr1 is at top
    scale_y_discrete(limits = rev(levels(df$chr1))) +

    # Labels & theme
    labs(
      x = "Relative position on the active HOR",
      y = "Chromosome",
      title = ""
    ) +
    theme_minimal(base_size = 15) +
    theme(
      panel.grid.major.y = element_blank(),
      panel.grid.minor = element_blank(),
      panel.grid.major.x = element_line(linewidth = 0.2),
      axis.title.y = element_text(margin = margin(r = 8), size = 16),
      axis.title.x = element_text(margin = margin(t = 8), size = 16),
      axis.text.y = element_text(face = "bold", size = 14),
      axis.text.x = element_text(size = 13),
      legend.title = element_text(size = 14, face = "bold"),
      legend.text = element_text(size = 13),
      plot.title = element_text(face = "bold", margin = margin(b = 10, t = 20), size = 18),
      legend.position = "right",
      plot.margin = margin(40, 16, 18, 12),
      plot.title.position = "plot"
    ) +
    coord_cartesian(clip = "off")

  # Save per-sample figure
  ggsave(
    filename = paste0(sid, ".diploid.CDRstats.png"),
    plot = p,
    width = 25,
    height = 18,
    units = "cm",
    dpi = 300
  )
}

@

